OPENAI_API_KEY=
FXTWITTER_API_BASE=https://api.fxtwitter.com
VXTWITTER_API_BASE=https://api.vxtwitter.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_API_VERSION=v25.0
# Use "music" for cookie-based image/carousel publishing. Graph is the safe default.
INSTAGRAM_PUBLISH_METHOD=graph
INSTAGRAM_PRIVATE_USERNAME=
INSTAGRAM_MUSIC_OVERLAP_DURATION_MS=30000
# Required by the cookie-based music publisher. Keep this file ignored.
INSTAGRAM_PRIVATE_SESSIONID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated Telegram sender IDs allowed to enqueue Codex jobs.
TELEGRAM_ALLOWED_USER_IDS=
# Optional minute (0-59) at which the hourly queue check runs. Default: 7.
CODEX_QUEUE_CRON_MINUTE=7
# Optional watcher overrides. Defaults keep state under .automation/watcher.
CODEX_WATCHER_STATE_DIR=
CODEX_WATCHER_DB=
POST_SOURCE=Bits Today
# Website delivery: blank URL disables the integration. Never expose key to Vite.
CONTENT_API_URL=
CONTENT_API_KEY=
CONTENT_OUTBOX_DIR=
# Private website object storage; never expose as frontend variables.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=thebitstoday-media
X_BEARER_TOKEN=
X_USER_ID=
X_AUTH_TOKEN=
X_CT0=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Tokens For Thought video generation and separate YouTube approval.
OPENROUTER_API_KEY=
STORY_VIDEO_OUTPUT_DIR=
# Optional internal URL for watcher -> story API; falls back to CONTENT_API_URL.
# On the VM prefer its loopback API URL rather than the public site proxy.
STORY_VIDEO_API_URL=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly
