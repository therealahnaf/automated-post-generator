FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY content_api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY content_api /app/content_api
RUN useradd --uid 10001 --create-home app
USER app
CMD ["sh", "-c", "python -m content_api.migrate && exec uvicorn content_api.app:app --host 0.0.0.0 --port 8001 --proxy-headers --forwarded-allow-ips=*"]
